    <!-- Offline Speech to Text -->
    <string name="te_ostt_missing">Na prepis treba Offline Speech to Text, bezplatnú aplikáciu, ktorá prevádza reč na text priamo v telefóne, bez internetu. Third Ear s ňou funguje oveľa lepšie. Ťukni a stiahni si ju zo Zapstore.</string>
