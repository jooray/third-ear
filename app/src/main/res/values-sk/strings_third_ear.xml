    <string name="te_wn_create_group">Vytvoriť testovaciu skupinu</string>
    <string name="te_wn_create_group_desc">Skupina, v ktorej je len Third Ear, na vyskúšanie odosielania bez otravovania ostatných. Ďalších členov do nej môžeš pozvať neskôr z White Noise.</string>
