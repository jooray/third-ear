    <string name="te_setting_white_noise">White Noise</string>
    <string name="te_setting_white_noise_desc">Aufnahmen an White-Noise-Gruppen senden und Antworten hören</string>
    <string name="te_setting_android_auto">Android Auto</string>
    <string name="te_setting_android_auto_desc">Third Ear zeigt seine Aktionen auf dem Autobildschirm und eingehende White-Noise-Nachrichten als Benachrichtigungen im Auto. Apps, die nicht aus einem Store stammen, brauchen in den Entwickleroptionen von Android Auto die Einstellung Unbekannte Quellen.</string>
