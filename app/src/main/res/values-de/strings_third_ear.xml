    <!-- White Noise -->
    <string name="te_channel_messages">White-Noise-Nachrichten</string>
    <string name="te_channel_white_noise">White-Noise-Verbindung</string>
    <string name="te_wn_connected">White Noise: wartet auf Nachrichten</string>
    <string name="te_wn_use">White Noise verwenden</string>
    <string name="te_wn_intro">Third Ear bekommt eine eigene White-Noise-Identität (npub). Lade sie in White Noise in eine Gruppe ein, nimm die Einladung hier an und wähle die Gruppe dann in einer Aktion. Nachrichten aus der Gruppe lassen sich abspielen oder vorlesen.</string>
    <string name="te_wn_unsupported">White Noise braucht ein 64-Bit-ARM-Handy (MarmotKit gibt es nur für arm64).</string>
    <string name="te_wn_starting">Verbinde…</string>
    <string name="te_wn_failed">White Noise konnte nicht gestartet werden: %s</string>
    <string name="te_wn_ready">Verbunden. Lade diesen npub in White Noise in eine Gruppe ein.</string>
    <string name="te_wn_identity">npub von Third Ear</string>
    <string name="te_wn_qr">QR-Code des npub</string>
    <string name="te_wn_copy_npub">npub kopieren</string>
    <string name="te_wn_copied">Kopiert</string>
    <string name="te_wn_copy">Kopieren</string>
    <string name="te_wn_invites">Einladungen</string>
    <string name="te_wn_accept">Annehmen</string>
    <string name="te_wn_decline">Ablehnen</string>
    <string name="te_wn_groups">Gruppen</string>
    <string name="te_wn_create_group">Testgruppe erstellen</string>
    <string name="te_wn_create_group_desc">Eine Gruppe nur mit Third Ear, um das Senden auszuprobieren, ohne jemanden zu stören. Weitere Mitglieder kannst du später in White Noise einladen.</string>
    <string name="te_wn_test_group_name">Third Ear Test</string>
    <string name="te_wn_messages">Letzte Nachrichten</string>
    <string name="te_wn_backup">Schlüsselsicherung</string>
    <string name="te_wn_show_nsec">nsec anzeigen (privater Schlüssel)</string>
    <string name="te_wn_nsec_warning">Der nsec ist der private Schlüssel der Identität und wird im Klartext angezeigt. Wer ihn hat, kann als Third Ear lesen und schreiben. Bewahre ihn in einem Passwortmanager auf.</string>
    <string name="te_wn_reveal">Anzeigen</string>
    <string name="te_wn_import_nsec">nsec importieren</string>
    <string name="te_wn_import_warning">Das ersetzt die Identität von Third Ear. Der npub kommt zurück, Kontakte und Freigabelisten funktionieren also weiter, die Gruppenmitgliedschaften aber nicht: Jede Gruppe muss den npub erneut einladen, und ältere Nachrichten lassen sich nicht lesen.</string>
    <string name="te_wn_import">Importieren</string>
    <string name="te_wn_not_nsec">Das ist kein nsec (er beginnt mit nsec1).</string>
