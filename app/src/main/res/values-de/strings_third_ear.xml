    <!-- Settings -->
    <string name="te_settings_third_ear">Third Ear</string>
    <string name="te_setting_bluetooth">Bluetooth-Mikrofon verwenden</string>
    <string name="te_setting_bluetooth_desc">Nimmt über ein verbundenes Bluetooth-Headset, Hörgeräte oder das Freisprechmikrofon im Auto auf. Während der Aufnahme ist das Headset im Telefonmodus, anderer Ton wird daher in schlechterer Qualität wiedergegeben. Ist nichts verbunden, nimmt das Handy-Mikrofon auf.</string>
    <string name="te_setting_spoken_cues">Gesprochene Hinweise</string>
    <string name="te_setting_spoken_cues_desc">„Du kannst sprechen“, sobald das Bluetooth-Mikrofon bereit ist, und was nach dem Stopp passiert („Gespeichert, wird transkribiert.“)</string>
    <string name="te_setting_pause_media">Wiedergabe während der Aufnahme pausieren</string>
    <string name="te_setting_pause_media_desc">Braucht Zugriff auf Benachrichtigungen, die einzige Möglichkeit, die Wiedergabe anderer Apps anzuhalten.</string>
    <string name="te_setting_transcriber">Transkriptions-App</string>
    <string name="te_setting_transcriber_none">Keine gefunden: Installiere Offline Speech to Text</string>
    <string name="te_setting_transcript_files">Transkripte als .txt neben den Aufnahmen speichern</string>
