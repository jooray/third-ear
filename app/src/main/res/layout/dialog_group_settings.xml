<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/activity_margin">

        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/te_group_replies"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/group_replies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/replies_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_replies_off" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/replies_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_replies_voice" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/replies_voice_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_replies_voice_text" />
        </RadioGroup>

        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_margin"
            android:text="@string/te_group_reading"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/group_reading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/reading_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_reading_auto" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/reading_ask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_reading_ask" />
        </RadioGroup>

        <org.fossify.commons.views.MyTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_margin"
            android:alpha="0.7"
            android:text="@string/te_reading_car_note" />

        <org.fossify.commons.views.MyTextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_margin"
            android:hint="@string/te_group_ignore">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/group_ignore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="2" />
        </org.fossify.commons.views.MyTextInputLayout>
    </LinearLayout>
</ScrollView>
