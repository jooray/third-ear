<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_margin"
        android:paddingTop="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin">

        <org.fossify.commons.views.MyTextInputLayout
            android:id="@+id/edit_action_name_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/te_action_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_action_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:singleLine="true" />
        </org.fossify.commons.views.MyTextInputLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/edit_action_destination_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_margin"
            android:text="@string/te_action_destination"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/edit_action_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/dest_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_dest_save" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/dest_copy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_dest_copy" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/dest_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_dest_share" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/dest_white_noise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_dest_white_noise" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/dest_webhook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_dest_webhook" />
        </RadioGroup>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/edit_action_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="@dimen/medium_margin"
            android:paddingBottom="@dimen/medium_margin"
            android:text="@string/te_action_pick_group" />

        <org.fossify.commons.views.MyTextInputLayout
            android:id="@+id/edit_action_url_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/te_action_webhook_url">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_action_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:singleLine="true" />
        </org.fossify.commons.views.MyTextInputLayout>

        <org.fossify.commons.views.MyTextInputLayout
            android:id="@+id/edit_action_auth_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_margin"
            android:hint="@string/te_action_webhook_auth">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_action_auth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />
        </org.fossify.commons.views.MyTextInputLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/edit_action_content_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_margin"
            android:text="@string/te_action_content"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/edit_action_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/content_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_content_audio" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/content_both"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_content_both" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/content_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/te_content_text" />
        </RadioGroup>

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/edit_action_transcribe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:text="@string/te_action_transcribe" />

        <org.fossify.commons.views.MyAppCompatCheckbox
            android:id="@+id/edit_action_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/te_action_copy" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/edit_action_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:alpha="0.8" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/edit_action_problems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_margin"
            android:layout_marginBottom="@dimen/medium_margin"
            android:textColor="@color/md_red_700" />
    </LinearLayout>
</ScrollView>
