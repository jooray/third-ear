  "components": [
    {
      "name": "Line Key",
      "kind": "custom",
      "refersTo": "line-key",
      "description": "One action on the board: code cell, lamp, name, state word, designation strip. The whole key is the target.",
      "html": "<button class=\"ds-key\"><span class=\"ds-key-top\"><span class=\"ds-code\">HRM</span><span class=\"ds-lamp ds-lamp-reply\"></span></span><span class=\"ds-key-name\">Ask Hermes</span><span class=\"ds-key-word\">1 reply waiting</span><span class=\"ds-strip\"><span>OSTT</span><span>HERMES</span><span>TEXT</span></span></button>",
      "css": ".ds-key{display:flex;flex-direction:column;width:200px;min-height:136px;padding:0;background:#211D18;color:#EDE8DA;border:1px solid #3A342B;border-radius:6px;overflow:hidden;text-align:left;cursor:pointer}.ds-key:active{background:#302A23}.ds-key:focus-visible{outline:2px solid #EDE8DA;outline-offset:2px}.ds-key-top{display:flex;align-items:center;justify-content:space-between;padding:10px 8px 0 12px}.ds-code{font-family:\"Saira Condensed\",sans-serif;text-transform:uppercase;font-weight:700;font-size:14px;letter-spacing:.1em;background:#C8321E;color:#F7F4EA;padding:3px 7px;border-radius:3px}.ds-lamp{width:16px;height:16px;border-radius:50%;border:2px solid #4A4337;box-sizing:border-box;background:#2E2922}.ds-lamp-reply{background:#F7F4EA;box-shadow:0 0 0 4px rgba(247,244,234,.16)}.ds-key-name{font-family:\"Atkinson Hyperlegible Next\",sans-serif;font-weight:700;font-size:19px;line-height:23px;padding:8px 12px 0}.ds-key-word{font-family:\"Atkinson Hyperlegible Next\",sans-serif;font-weight:700;font-size:14px;padding:2px 12px 0}.ds-strip{display:flex;margin-top:auto;background:#E6E0CE;color:#1E1A14}.ds-strip span{font-family:\"Saira Condensed\",sans-serif;text-transform:uppercase;font-weight:600;font-size:12px;letter-spacing:.06em;padding:5px 8px;border-left:1px solid #B4AD9B}.ds-strip span:first-child{border-left:0}"
    },
    {
      "name": "Lamps",
      "kind": "custom",
      "refersTo": "lamp",
      "description": "Opal lamps: off, busy (flashes 700/300 ms in hard steps), reply, fault. Always with a word.",
      "html": "<div class=\"ds-lamps\"><span><span class=\"ds-lamp ds-lamp-off\"></span> Idle</span><span><span class=\"ds-lamp ds-lamp-busy\"></span> Transcribing</span><span><span class=\"ds-lamp ds-lamp-reply\"></span> 1 reply waiting</span><span><span class=\"ds-lamp ds-lamp-fault\"></span> Not delivered</span></div>",
      "css": ".ds-lamps{display:flex;gap:16px;font-family:\"Atkinson Hyperlegible Next\",sans-serif;font-weight:700;font-size:14px;color:#EDE8DA;background:#16130F;padding:12px}.ds-lamps span{display:flex;align-items:center;gap:6px}.ds-lamp{width:16px;height:16px;border-radius:50%;border:2px solid #4A4337;box-sizing:border-box;background:#2E2922}.ds-lamp-busy{background:#F2A33A;animation:ds-relay 1s steps(1) infinite}.ds-lamp-reply{background:#F7F4EA}.ds-lamp-fault{background:#E5483A}@keyframes ds-relay{0%{background:#F2A33A}70%{background:#2E2922}}@media(prefers-reduced-motion:reduce){.ds-lamp-busy{animation:none}}"
    },
    {
      "name": "Code Cell",
